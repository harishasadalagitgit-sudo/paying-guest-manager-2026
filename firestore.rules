rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Help validators
    function isValidId(id) {
      return id.size() > 0 && id.size() <= 100;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /residents/{residentId} {
      allow read, write: if true;
    }

    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /incomingPayments/{paymentId} {
      allow read, write: if true;
    }

    match /hotelBookingRequests/{reqId} {
      allow read, write: if true;
    }

    // Staging collections used by the MiSpace PG desktop app. Entries here
    // are supervisor-submitted and reviewer-approved before being copied
    // into the live `incomingPayments` / `expenses` collections above.
    match /deskIncomeEntries/{entryId} {
      allow read, write: if true;
    }

    match /deskExpenseEntries/{entryId} {
      allow read, write: if true;
    }

    // Historical record of residents who have moved out, written by the
    // MiSpace PG desktop app's Update Residents screen.
    match /vacatedResidents/{entryId} {
      allow read, write: if true;
    }

    // Reservations — someone who paid an advance and is holding a room/bed
    // but hasn't moved in yet. Converting one creates a `residents` doc.
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
